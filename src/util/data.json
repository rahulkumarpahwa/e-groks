  "Triangle Rotation": {
    "prefix": "triangle-rotate",
    "body": [
      "#include \"graphics.h\"",
      "#include <conio.h>",
      "#include <stdio.h>",
      "#include <math.h>",
      "#define PI 3.14159265358979323846",
      "",
      "void rotate_point(double xc, double yc, double x, double y, double angle_deg, double *rx, double *ry) {",
      "\tdouble angle = angle_deg * PI / 180.0;",
      "\tdouble s = sin(angle), c = cos(angle);",
      "\tdouble tx = x - xc; double ty = y - yc;",
      "\tdouble nx = tx * c - ty * s; double ny = tx * s + ty * c;",
      "\t*rx = nx + xc; *ry = ny + yc;",
      "}",
      "",
      "int main() {",
      "\tint gd = DETECT, gm; initgraph(&gd, &gm, \"\");",
      "\tdouble x1, y1, x2, y2, x3, y3, xc, yc, angle;",
      "\tprintf(\"Enter triangle x1 y1 x2 y2 x3 y3 and center xc yc and angle: \");",
      "\tif (scanf(\"%lf %lf %lf %lf %lf %lf %lf %lf %lf\", &x1, &y1, &x2, &y2, &x3, &y3, &xc, &yc, &angle) != 9) { closegraph(); return 0; }",
      "\tdouble rx1, ry1, rx2, ry2, rx3, ry3;",
      "\trotate_point(xc, yc, x1, y1, angle, &rx1, &ry1);",
      "\trotate_point(xc, yc, x2, y2, angle, &rx2, &ry2);",
      "\trotate_point(xc, yc, x3, y3, angle, &rx3, &ry3);",
      "\tsetcolor(WHITE);",
      "\tline((int)round(x1), (int)round(y1), (int)round(x2), (int)round(y2));",
      "\tline((int)round(x2), (int)round(y2), (int)round(x3), (int)round(y3));",
      "\tline((int)round(x3), (int)round(y3), (int)round(x1), (int)round(y1));",
      "\tsetcolor(GREEN);",
