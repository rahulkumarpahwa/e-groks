      "void bresenham_circle(int xc, int yc, int r) {",
      "\tint x = 0;",
      "\tint y = r;",
      "\tint d = 3 - 2 * r;",
      "\twhile (x <= y) {",
      "\t\tputpixel(xc + x, yc + y, WHITE);",
      "\t\tputpixel(xc - x, yc + y, WHITE);",
      "\t\tputpixel(xc + x, yc - y, WHITE);",
      "\t\tputpixel(xc - x, yc - y, WHITE);",
      "\t\tputpixel(xc + y, yc + x, WHITE);",
      "\t\tputpixel(xc - y, yc + x, WHITE);",
      "\t\tputpixel(xc + y, yc - x, WHITE);",
      "\t\tputpixel(xc - y, yc - x, WHITE);",
      "\t\tif (d < 0) d = d + 4 * x + 6;",
      "\t\telse { d = d + 4 * (x - y) + 10; y--; }",
      "\t\tx++;",
