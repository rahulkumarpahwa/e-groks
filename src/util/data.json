      "\tline((int)round(rx2), (int)round(ry2), (int)round(rx3), (int)round(ry3));",
      "\tline((int)round(rx3), (int)round(ry3), (int)round(rx1), (int)round(ry1));",
      "\tgetch(); closegraph(); return 0;",
      "}"
