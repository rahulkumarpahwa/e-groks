  "Point Rotation": {
    "prefix": "rotate-point",
    "body": [
      "#include \"graphics.h\"",
      "#include <conio.h>",
      "#include <stdio.h>",
      "#include <math.h>",
      "#define PI 3.14159265358979323846",
      "",
      "void rotate_point(int xc, int yc, int x, int y, double angle_deg, int *rx, int *ry) {",
      "\tdouble angle = angle_deg * PI / 180.0;",
      "\tdouble s = sin(angle), c = cos(angle);",
      "\tdouble tx = x - xc;",
      "\tdouble ty = y - yc;",
      "\tdouble nx = tx * c - ty * s;",
      "\tdouble ny = tx * s + ty * c;",
      "\t*rx = (int)round(nx + xc);",
      "\t*ry = (int)round(ny + yc);",
      "}",
      "",
      "int main() {",
      "\tint gd = DETECT, gm;",
      "\tinitgraph(&gd, &gm, \"\");",
      "\tint xc, yc, x, y;",
      "\tdouble angle;",
      "\tprintf(\"Enter center xc yc and point x y and angle (deg): \");",
      "\tif (scanf(\"%d %d %d %d %lf\", &xc, &yc, &x, &y, &angle) != 5) { closegraph(); return 0; }",
      "\tint rx, ry;",
      "\trotate_point(xc, yc, x, y, angle, &rx, &ry);",
      "\tsetcolor(WHITE);",
      "\tputpixel(x, y, RED);",
      "\tputpixel(rx, ry, GREEN);",
      "\tline(xc, yc, x, y);",
      "\tline(xc, yc, rx, ry);",
      "\tgetch(); closegraph(); return 0;",
      "}"
    ],
    "description": "Rotate a Point Around a Center"
  },
