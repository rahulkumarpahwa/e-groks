  "Cohen-Sutherland Line Clipping": {
    "prefix": "cohen-sutherland",
    "body": [
      "/*",
      " * Cohen-Sutherland Line Clipping Algorithm",
      " */",
      "#include \"graphics.h\"",
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <math.h>",
      "#include<conio.h>",
      "",
      "#define INSIDE 0",
      "#define LEFT 1",
      "#define RIGHT 2",
      "#define BOTTOM 4",
      "#define TOP 8",
      "",
      "typedef struct { int x1, y1, x2, y2; } Line;",
      "typedef struct { int xmin, ymin, xmax, ymax; } Window;",
      "",
      "int computeCode(int x, int y, Window window) {",
      "\tint code = INSIDE;",
      "\tif (x < window.xmin) code |= LEFT;",
      "\telse if (x > window.xmax) code |= RIGHT;",
      "\tif (y < window.ymin) code |= BOTTOM;",
      "\telse if (y > window.ymax) code |= TOP;",
      "\treturn code;",
      "}",
      "",
      "int cohen_sutherland(Line *line, Window window) {",
      "\tint code1 = computeCode(line->x1, line->y1, window);",
      "\tint code2 = computeCode(line->x2, line->y2, window);",
      "\tint accept = 0;",
      "\twhile (1) {",
      "\t\tif ((code1 | code2) == 0) { accept = 1; break; }",
      "\t\telse if ((code1 & code2) != 0) { break; }",
      "\t\telse {",
      "\t\t\tint code_out = code1 ? code1 : code2;",
      "\t\t\tint x, y;",
      "\t\t\tif (code_out & TOP) {",
      "\t\t\t\tx = line->x1 + (line->x2 - line->x1) * (window.ymax - line->y1) / (line->y2 - line->y1);",
      "\t\t\t\ty = window.ymax;",
      "\t\t\t} else if (code_out & BOTTOM) {",
      "\t\t\t\tx = line->x1 + (line->x2 - line->x1) * (window.ymin - line->y1) / (line->y2 - line->y1);",
      "\t\t\t\ty = window.ymin;",
      "\t\t\t} else if (code_out & RIGHT) {",
      "\t\t\t\ty = line->y1 + (line->y2 - line->y1) * (window.xmax - line->x1) / (line->x2 - line->x1);",
      "\t\t\t\tx = window.xmax;",
      "\t\t\t} else {",
      "\t\t\t\ty = line->y1 + (line->y2 - line->y1) * (window.xmin - line->x1) / (line->x2 - line->x1);",
      "\t\t\t\tx = window.xmin;",
      "\t\t\t}",
      "\t\t\tif (code_out == code1) { line->x1 = x; line->y1 = y; code1 = computeCode(line->x1, line->y1, window); }",
      "\t\t\telse { line->x2 = x; line->y2 = y; code2 = computeCode(line->x2, line->y2, window); }",
      "\t\t}",
      "\t}",
      "\treturn accept;",
      "}",
      "",
      "int main() {",
      "\tint gdriver = DETECT, gmode;",
      "\tinitgraph(&gdriver, &gmode, \"C:\\\\MINGW\\\\lib\\\\libbgi\");",
      "\tif (graphresult() != grOk) { printf(\"Graphics initialization failed\\n\"); return -1; }",
      "\tint max_x = getmaxx(); int max_y = getmaxy();",
      "\tcleardevice();",
      "\tWindow window = {150, 100, 500, 400};",
      "\tsetcolor(YELLOW); outtextxy(max_x/2 - 150, 20, \"Cohen-Sutherland Line Clipping\");",
      "\tsetcolor(GREEN); rectangle(window.xmin, window.ymin, window.xmax, window.ymax);",
      "\tsetcolor(RED); Line lines[] = {{50,150,300,300},{100,50,400,450},{550,50,600,400}};",
      "\tint num_lines = 3;",
      "\tfor (int i=0;i<num_lines;i++) line(lines[i].x1, lines[i].y1, lines[i].x2, lines[i].y2);",
      "\tgetch(); closegraph(); return 0;",
      "}"
    ],
    "description": "Cohen-Sutherland Line Clipping Algorithm"
  },
  "Tower of Hanoi": {
    "prefix": "hanoi",
    "body": [
      "#include <stdio.h>",
      "",
      "void hanoi(int n, char from, char to, char aux) {",
      "\tif (n == 0) return;",
      "\thanoi(n - 1, from, aux, to);",
      "\tprintf(\"Move disk %d from %c to %c\\n\", n, from, to);",
      "\thanoi(n - 1, aux, to, from);",
      "}",
      "",
      "int main() {",
      "\tint n;",
      "\tprintf(\"Enter number of disks for Tower of Hanoi: \");",
      "\tif (scanf(\"%d\", &n) != 1) return 0;",
      "\tprintf(\"Solution:\\n\");",
      "\thanoi(n, 'A', 'C', 'B');",
      "\treturn 0;",
      "}"
    ],
    "description": "Tower of Hanoi Recursive Solution"
