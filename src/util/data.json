    "body": [
      "#include \"graphics.h\"",
      "#include <conio.h>",
      "#include <stdio.h>",
      "",
      "int point_inside_rect(int x, int y, int xmin, int ymin, int xmax, int ymax) {",
      "\treturn (x >= xmin && x <= xmax && y >= ymin && y <= ymax);",
      "}",
      "",
      "int main() {",
      "\tint gd = DETECT, gm;",
      "\tinitgraph(&gd, &gm, \"\");",
      "\tint xmin = 150, ymin = 100, xmax = 500, ymax = 400;",
      "\trectangle(xmin, ymin, xmax, ymax);",
      "\tsetcolor(WHITE);",
      "\touttextxy(20, 20, \"Enter point coordinates to test if inside rect\");",
      "\tint x, y;",
      "\tprintf(\"Enter point x y: \");",
      "\tif (scanf(\"%d %d\", &x, &y) != 2) { closegraph(); return 0; }",
      "\tif (point_inside_rect(x, y, xmin, ymin, xmax, ymax)) {",
      "\t\tputpixel(x, y, GREEN);",
      "\t\tprintf(\"Point is inside\\n\");",
      "\t} else {",
      "\t\tputpixel(x, y, RED);",
      "\t\tprintf(\"Point is outside\\n\");",
      "\t}",
      "\tgetch(); closegraph(); return 0;",
      "}"
    ],
