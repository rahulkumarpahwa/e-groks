  "Line Intersection": {
    "prefix": "line-intersection",
    "body": [
      "#include <stdio.h>",
      "#include \"graphics.h\"",
      "#include <conio.h>",
      "#include <math.h>",
      "",
      "int compute_intersection(double x1, double y1, double x2, double y2,",
      "\t\t\t\t   double x3, double y3, double x4, double y4,",
      "\t\t\t\t   double *ix, double *iy) {",
      "\tdouble a1 = y2 - y1;",
      "\tdouble b1 = x1 - x2;",
      "\tdouble c1 = a1 * x1 + b1 * y1;",
      "\tdouble a2 = y4 - y3;",
      "\tdouble b2 = x3 - x4;",
      "\tdouble c2 = a2 * x3 + b2 * y3;",
      "\tdouble det = a1 * b2 - a2 * b1;",
      "\tif (fabs(det) < 1e-9) return 0;",
      "\t*ix = (b2 * c1 - b1 * c2) / det;",
      "\t*iy = (a1 * c2 - a2 * c1) / det;",
      "\treturn 1;",
      "}",
      "",
      "int main() {",
      "\tint x1, y1, x2, y2, x3, y3, x4, y4;",
      "\tprintf(\"Enter A(x1 y1) B(x2 y2) C(x3 y3) D(x4 y4): \\n\");",
      "\tif (scanf(\"%d %d %d %d %d %d %d %d\", &x1, &y1, &x2, &y2, &x3, &y3, &x4, &y4) != 8) return 0;",
      "\tdouble ix, iy;",
      "\tint ok = compute_intersection(x1, y1, x2, y2, x3, y3, x4, y4, &ix, &iy);",
      "\tif (!ok) { printf(\"Lines are parallel or coincident\\n\"); return 0; }",
      "\tprintf(\"Intersection at: (%f, %f)\\n\", ix, iy);",
      "\tint gd = DETECT, gm; initgraph(&gd, &gm, \"\");",
      "\tline(x1, y1, x2, y2); line(x3, y3, x4, y4);",
      "\tputpixel((int)round(ix), (int)round(iy), GREEN);",
      "\tgetch(); closegraph(); return 0;",
      "}"
    ],
    "description": "Compute Intersection of Two Lines"
  },
