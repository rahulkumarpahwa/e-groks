  "DDA Line Algorithm": {
    "prefix": "dda-line",
    "body": [
      "/*",
      " * DDA (Digital Differential Analyzer) Line Drawing Algorithm",
      " */",
      "#include \"graphics.h\"",
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <math.h>",
      "#include<conio.h>",
      "",
      "void dda_line(int x0, int y0, int x1, int y1) {",
      "\tint dx = x1 - x0;",
      "\tint dy = y1 - y0;",
      "\tint steps = abs(dx) > abs(dy) ? abs(dx) : abs(dy);",
      "\tfloat x_inc = (float)dx / steps;",
      "\tfloat y_inc = (float)dy / steps;",
      "\tfloat x = x0;",
      "\tfloat y = y0;",
      "\tfor (int i = 0; i <= steps; i++) {",
      "\t\tputpixel(round(x), round(y), WHITE);",
      "\t\tx += x_inc;",
      "\t\ty += y_inc;",
      "\t}",
      "}",
      "",
      "int main() {",
      "\tint gdriver = DETECT, gmode;",
      "\tinitgraph(&gdriver, &gmode, \"C:\\\\MINGW\\\\lib\\\\libbgi\");",
      "\tif (graphresult() != grOk) {",
      "\t\tprintf(\"Graphics initialization failed\\n\");",
      "\t\treturn -1;",
      "\t}",
      "\tint max_x = getmaxx();",
      "\tint max_y = getmaxy();",
      "\tcleardevice();",
      "\tdda_line(400, 100, 600, 300);",
      "\tsetcolor(YELLOW);",
      "\touttextxy(20, max_y - 40, \"Press any key to exit...\");",
      "\tgetch();",
      "\tclosegraph();",
      "\treturn 0;",
      "}"
    ],
    "description": "DDA (Digital Differential Analyzer) Line Drawing Algorithm"
  },
  "Bresenham Line Algorithm": {
    "prefix": "bresenham-line",
    "body": [
      "/*",
      " * Bresenham Line Drawing Algorithm",
      " */",
      "",
      "#include \"graphics.h\"",
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <math.h>",
      "#include <conio.h>",
      "",
      "void bresenham_line(int x0, int y0, int x1, int y1)",
      "{",
      "    int dx = abs(x1 - x0);",
      "    int dy = abs(y1 - y0);",
      "    int d = 2 * dy - dx;",
      "    int x = x0;",
      "    int y = y0;",
      "    while (1)",
      "    {",
      "        putpixel(x, y, GREEN);",
      "        if (x == x1 && y == y1)",
      "            break;",
      "        if(d<0){",
      "            d = d + 2 * dy;",
      "        } else {",
      "            d = d + 2* (dy -dx);",
      "            y++;",
      "        }",
      "        x++;",
      "    }",
      "}",
      "",
      "int main()",
      "{",
      "    int gdriver = DETECT, gmode;",
      "    initgraph(&gdriver, &gmode, \"\");",
      "    cleardevice();",
      "    bresenham_line(50, 50, 300, 300);",
      "    outtextxy(20, getmaxy() - 40, \"Press any key to exit...\");",
      "    getch();",
      "    closegraph();",
      "    return 0;",
      "}"
    ],
    "description": "Bresenham Line Drawing Algorithm"
  },
  "Direct Method Line Algorithm": {
    "prefix": "direct-line",
    "body": [
      "#include \"graphics.h\"",
      "#include <conio.h>",
      "#include <stdio.h>",
      "#include <math.h>",
      "",
      "int main() {",
      "\tint gd = DETECT, gm;",
      "\tinitgraph(&gd, &gm, \"\");",
      "\tint x0, y0, x1, y1;",
      "\tprintf(\"Enter x0 y0 x1 y1: \");",
      "\tscanf(\"%d %d %d %d\", &x0, &y0, &x1, &y1);",
      "\tint dx = x1 - x0;",
      "\tint dy = y1 - y0;",
      "\tif (dx == 0) {",
      "\t\tint ys = (y0 < y1) ? y0 : y1;",
      "\t\tint ye = (y0 < y1) ? y1 : y0;",
      "\t\tfor (int y = ys; y <= ye; ++y)",
      "\t\t\tputpixel(x0, y, WHITE);",
      "\t} else if (dy == 0) {",
      "\t\tint xs = (x0 < x1) ? x0 : x1;",
      "\t\tint xe = (x0 < x1) ? x1 : x0;",
      "\t\tfor (int x = xs; x <= xe; ++x)",
      "\t\t\tputpixel(x, y0, WHITE);",
      "\t} else {",
      "\t\tdouble m = (double)dy / (double)dx;",
      "\t\tif (fabs(m) <= 1.0) {",
      "\t\t\tint xs = (x0 < x1) ? x0 : x1;",
      "\t\t\tint xe = (x0 < x1) ? x1 : x0;",
      "\t\t\tint base = (x0 < x1) ? x0 : x1;",
      "\t\t\tint otherY = (x0 < x1) ? y0 : y1;",
      "\t\t\tfor (int x = xs; x <= xe; ++x) {",
      "\t\t\t\tdouble y = otherY + m * (x - base);",
      "\t\t\t\tputpixel(x, (int)round(y), WHITE);",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\tgetch();",
      "\tclosegraph();",
      "\treturn 0;",
      "}"
    ],
    "description": "Direct Method Line Algorithm"
  },
