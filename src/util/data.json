  "2D Transformations": {
    "prefix": "2d-transforms",
    "body": [
      "/*",
      " * 2D Geometric Transformations",
      " * Includes: Translation, Rotation, Scaling, Reflection, Shearing",
      " */",
      "#include \"graphics.h\"",
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <math.h>",
      "#include <conio.h>",
      "",
      "#define PI 3.14159265359",
      "",
      "typedef struct { float x, y; } Point;",
      "typedef struct { Point vertices[10]; int num_vertices; } Polygon;",
      "",
      "void draw_polygon(Polygon poly, int color) {",
      "\tsetcolor(color);",
      "\tfor (int i = 0; i < poly.num_vertices; i++) {",
      "\t\tint x1 = poly.vertices[i].x;",
      "\t\tint y1 = poly.vertices[i].y;",
      "\t\tint x2 = poly.vertices[(i + 1) % poly.num_vertices].x;",
      "\t\tint y2 = poly.vertices[(i + 1) % poly.num_vertices].y;",
      "\t\tline(x1, y1, x2, y2);",
      "\t}",
      "}",
      "",
      "Polygon translate(Polygon poly, float tx, float ty) {",
      "\tPolygon translated = poly;",
      "\tfor (int i = 0; i < poly.num_vertices; i++) {",
      "\t\ttranslated.vertices[i].x = poly.vertices[i].x + tx;",
      "\t\ttranslated.vertices[i].y = poly.vertices[i].y + ty;",
      "\t}",
      "\treturn translated;",
      "}",
      "",
      "Polygon scale(Polygon poly, float sx, float sy, float cx, float cy) {",
      "\tPolygon scaled = poly;",
      "\tfor (int i = 0; i < poly.num_vertices; i++) {",
      "\t\tscaled.vertices[i].x = cx + (poly.vertices[i].x - cx) * sx;",
      "\t\tscaled.vertices[i].y = cy + (poly.vertices[i].y - cy) * sy;",
      "\t}",
      "\treturn scaled;",
      "}",
      "",
      "Polygon rotate(Polygon poly, float angle, float cx, float cy) {",
      "\tPolygon rotated = poly;",
      "\tfloat rad = angle * PI / 180.0;",
      "\tfloat cos_a = cos(rad);",
      "\tfloat sin_a = sin(rad);",
      "\tfor (int i = 0; i < poly.num_vertices; i++) {",
      "\t\tfloat x = poly.vertices[i].x - cx;",
      "\t\tfloat y = poly.vertices[i].y - cy;",
      "\t\trotated.vertices[i].x = cx + (x * cos_a - y * sin_a);",
      "\t\trotated.vertices[i].y = cy + (x * sin_a + y * cos_a);",
      "\t}",
      "\treturn rotated;",
      "}",
      "",
      "Polygon reflect_x(Polygon poly, float cy) {",
      "\tPolygon reflected = poly;",
      "\tfor (int i = 0; i < poly.num_vertices; i++) {",
      "\t\treflected.vertices[i].x = poly.vertices[i].x;",
      "\t\treflected.vertices[i].y = 2 * cy - poly.vertices[i].y;",
      "\t}",
      "\treturn reflected;",
      "}",
      "",
      "Polygon reflect_y(Polygon poly, float cx) {",
      "\tPolygon reflected = poly;",
      "\tfor (int i = 0; i < poly.num_vertices; i++) {",
      "\t\treflected.vertices[i].x = 2 * cx - poly.vertices[i].x;",
      "\t\treflected.vertices[i].y = poly.vertices[i].y;",
      "\t}",
      "\treturn reflected;",
      "}",
      "",
      "Polygon shear_x(Polygon poly, float shear_factor) {",
      "\tPolygon sheared = poly;",
      "\tfor (int i = 0; i < poly.num_vertices; i++) {",
      "\t\tsheared.vertices[i].x = poly.vertices[i].x + shear_factor * poly.vertices[i].y;",
      "\t\tsheared.vertices[i].y = poly.vertices[i].y;",
      "\t}",
      "\treturn sheared;",
      "}",
      "",
      "int main() {",
      "\tint gdriver = DETECT, gmode;",
      "\tinitgraph(&gdriver, &gmode, \"C:\\\\MINGW\\\\lib\\\\libbgi\");",
      "\tif (graphresult() != grOk) { printf(\"Graphics initialization failed\\n\"); return -1; }",
      "\tint max_x = getmaxx();",
      "\tint max_y = getmaxy();",
      "\tcleardevice();",
      "\tsetcolor(YELLOW);",
      "\touttextxy(max_x / 2 - 150, 10, \"2D Geometric Transformations\");",
      "\tPolygon square;",
      "\tsquare.num_vertices = 4;",
      "\tsquare.vertices[0].x = 50; square.vertices[0].y = 100;",
      "\tsquare.vertices[1].x = 100; square.vertices[1].y = 100;",
      "\tsquare.vertices[2].x = 100; square.vertices[2].y = 150;",
      "\tsquare.vertices[3].x = 50; square.vertices[3].y = 150;",
      "\tsetcolor(LIGHTCYAN);",
      "\touttextxy(20, 50, \"1. TRANSLATION\");",
      "\tdraw_polygon(square, WHITE);",
      "\tPolygon translated = translate(square, 80, 0);",
      "\tdraw_polygon(translated, GREEN);",
      "\tsetcolor(YELLOW);",
      "\touttextxy(20, max_y - 40, \"Press any key to exit...\");",
      "\tgetch();",
      "\tclosegraph();",
      "\treturn 0;",
      "}"
    ],
    "description": "2D Geometric Transformations (translate, scale, rotate, reflect, shear)"
  }
