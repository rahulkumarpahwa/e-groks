  "Bubble Shot Visualization": {
    "prefix": "bubble-shot",
    "body": [
      "#include \"graphics.h\"",
      "#include <conio.h>",
      "#include <stdlib.h>",
      "#include <time.h>",
      "",
      "typedef struct { int x, y, r, dy, color; } Bubble;",
      "",
      "int main() {",
      "\tint gd = DETECT, gm;",
      "\tinitgraph(&gd, &gm, \"\");",
      "\tint maxx = getmaxx(), maxy = getmaxy();",
      "\tsrand(time(NULL));",
      "\tconst int N = 8;",
      "\tBubble b[N];",
      "\tfor (int i = 0; i < N; i++) {",
      "\t\tb[i].r = 20 + rand() % 20;",
      "\t\tb[i].x = 50 + i * 80;",
      "\t\tb[i].y = 50 + rand() % 100;",
      "\t\tb[i].dy = 2 + rand() % 4;",
      "\t\tb[i].color = rand() % 15 + 1;",
      "\t}",
      "\twhile (!kbhit()) {",
      "\t\tcleardevice();",
      "\t\tfor (int i = 0; i < N; i++) {",
      "\t\t\tsetcolor(b[i].color);",
      "\t\t\tsetfillstyle(SOLID_FILL, b[i].color);",
      "\t\t\tcircle(b[i].x, b[i].y, b[i].r);",
      "\t\t\tfloodfill(b[i].x, b[i].y, b[i].color);",
      "\t\t\tb[i].y += b[i].dy;",
      "\t\t\tif (b[i].y + b[i].r >= maxy - 20) { b[i].y = maxy - 20 - b[i].r; b[i].dy = -b[i].dy; }",
      "\t\t\tif (b[i].y - b[i].r <= 20) { b[i].y = 20 + b[i].r; b[i].dy = -b[i].dy; }",
      "\t\t}",
      "\t\tdelay(50);",
      "\t}",
      "\tgetch(); closegraph(); return 0;",
      "}"
    ],
    "description": "Bubble Shot Visualization with bouncing circles"
  },
  "Point In Clipping Boundary": {
